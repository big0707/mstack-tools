# 飞书应用凭证配置
# 从飞书开放平台获取: https://open.feishu.cn/

# 应用 ID (必填)
FEISHU_APP_ID=your_app_id_here

# 应用密钥 (必填)
FEISHU_APP_SECRET=your_app_secret_here

# 默认文档文件夹 Token (可选)
# 文档将创建在该文件夹下，不填则创建在应用关联的默认位置
FEISHU_DEFAULT_FOLDER_TOKEN=

# 默认分享模式：internal=企业内部拿到链接可访问；private=仅创建者/应用/授权成员；public=外部链接
FEISHU_DEFAULT_SHARE_MODE=internal

# 企业内部链接权限：tenant_readable=组织内拿到链接可阅读；tenant_editable=组织内拿到链接可编辑
FEISHU_INTERNAL_LINK_PERMISSION=tenant_readable

# 机密或定向授权时使用：默认额外授权成员 open_id，逗号分隔（可选）
FEISHU_DEFAULT_MEMBER_IDS=

# 授权成员默认权限：view/edit/full_access
FEISHU_DEFAULT_MEMBER_PERMISSION=view
