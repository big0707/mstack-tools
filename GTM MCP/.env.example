# Optional default GTM account (numeric accountId, not the display name).
GTM_ACCOUNT_ID=

# Default container. Prefer the public ID GTM-XXXXXXX.
# Numeric containerId and full accounts/{id}/containers/{id} paths also work.
GTM_CONTAINER_ID=GTM-XXXXXXX

# Optional named aliases. Agents can pass these instead of raw IDs.
# GTM_CONTAINER_DEMO=GTM-XXXXXXX
# GTM_CONTAINER_DEMOTHREE=GTM-YYYYYYY

# Optional workspace ID or name. Empty means Default Workspace, else the first workspace.
GTM_WORKSPACE_ID=

# Set true to block every write/publish tool, even with confirm=true.
GTM_READ_ONLY=false

# Absolute path to a Google service-account JSON key.
# Keep the JSON file outside this repository. Do not paste the private key here.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\gtm-service-account.json
