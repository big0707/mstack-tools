# Default GA4 Property ID plus named properties. Use numeric Property IDs,
# not Measurement IDs such as G-XXXX.
GA4_PROPERTY_ID=123456789
GA4_PROPERTY_DEMO=123456789
GA4_PROPERTY_DEMOTHREE=123456782
GA4_PROPERTY_DEMOFOUR=123456781
GA4_PROPERTY_DEMOTWO=123456780
GA4_PROPERTY_DEMOFIVE=123456783
GA4_PROPERTY_DEMOSIX=123456784
GA4_PROPERTY_DEMOSEVEN=123456785

# Absolute path to a Google service-account JSON key that has Viewer access
# to the GA4 property. Keep the JSON file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\ga4-service-account.json
