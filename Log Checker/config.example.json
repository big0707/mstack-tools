{
  "project": "example-logs",
  "logstore": "example-site",
  "endpoint": "https://us-west-1.log.aliyuncs.com",
  "region": "us-west-1",
  "console_url": "https://sls.console.aliyun.com/lognext/project/example-logs/logsearch/example-site",
  "schema_verified": false,
  "fields": {
    "status": "status",
    "latency": "request_time",
    "path": "request_uri",
    "ip": "remote_addr",
    "user_agent": "http_user_agent"
  },
  "latency_unit": "seconds",
  "window_minutes": 15,
  "ingestion_delay_seconds": 120,
  "poll_seconds": 300,
  "timeout_seconds": 20,
  "thresholds": {
    "minimum_requests": 100,
    "minimum_field_coverage": 0.99,
    "server_error_rate": 0.01,
    "not_found_rate": 0.10,
    "rate_limited_rate": 0.01,
    "p95_seconds": 2.0,
    "slow_seconds": 2.0,
    "traffic_drop_ratio": 0.5,
    "traffic_spike_ratio": 3.0
  }
}
