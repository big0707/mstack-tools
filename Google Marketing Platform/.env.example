# Copy to .env. scripts/setup.ps1 creates and fills .env only when it does not yet exist.

# Service accounts used for discovery / read-only listing.
GMP_GA_CREDENTIALS=
GMP_GSC_CREDENTIALS=
# Optional override. When blank, the agent reuses ../GTM MCP/.env's
# GOOGLE_APPLICATION_CREDENTIALS path without copying the key.
GMP_GTM_CREDENTIALS=
# Optional override for the GMP organization identity. Defaults to the GTM
# credential, which is the identity shown in the user-provided org-role evidence.
GMP_ORG_CREDENTIALS=

# Read-only source of the Ads developer token. Its login identity is ignored here.
# Never edit the Adwords API project's YAML to configure personnel management.
GMP_ADS_YAML=

# Dedicated personnel-management key; defaults to GMP_ORG_CREDENTIALS / GTM key.
# Must belong to YOUR_GMP_SA@YOUR_GCP_PROJECT.iam.gserviceaccount.com.
# Missing/invalid/wrong identity fails closed; no fallback to the ad-serving key.
GMP_ADS_CREDENTIALS=

# Optional user OAuth for GA/GTM. It never overrides the dedicated Ads identity.
# Create a Desktop OAuth client and save it as credentials/oauth-client.json
# or set these two variables. Do not commit secrets.
GMP_OAUTH_CLIENT_FILE=credentials/oauth-client.json
GMP_OAUTH_TOKEN_FILE=credentials/token.json
# GMP_OAUTH_CLIENT_ID=
# GMP_OAUTH_CLIENT_SECRET=

# MCC used when inviting Ads users at the manager level.
GMP_ADS_LOGIN_CUSTOMER_ID=1234567890
GMP_ADS_API_VERSION=v24

# Search Console Full/Restricted user changes have no public API and therefore
# always remain manual_required. This project never automates a browser.
