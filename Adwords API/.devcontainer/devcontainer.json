{
  "name": "Adwords API Agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]' && bash scripts/init_cloud_config.sh || true"
}
